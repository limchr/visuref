{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "VisArt",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5680
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/backend",
          "remoteRoot": "/app"
        }
      ],
      "preLaunchTask": "debug-up",
      "postDebugTask": "debug-down"
    }
  ]
}
